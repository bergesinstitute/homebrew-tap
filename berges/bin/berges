#!/usr/bin/env bash
# Berges CLI: Berges AI as an agent in your terminal, built on goose.
#
# Runs goose with its own settings folder (GOOSE_PATH_ROOT), the Berges AI
# provider and this computer's key, so it never touches a separate goose setup.
# Written for the bash 3.2 that ships with macOS.

set -euo pipefail

VERSION="0.1.0"
API_URL="${BERGES_API_URL:-https://berges.ai/api/v1}"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/berges"
GOOSE_ROOT="$STATE_DIR/goose"
ME_CACHE="$STATE_DIR/me.json"
KEY_FILE="$STATE_DIR/credentials"
KEYCHAIN_SERVICE="berges-cli"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
SPRITES_DIR="$SCRIPT_DIR/../share/berges/sprites"
[ -d "$SPRITES_DIR" ] || SPRITES_DIR="$SCRIPT_DIR/../sprites"

die() { printf '%s\n' "$*" >&2; exit 1; }

require() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is missing. Reinstall with: brew reinstall berges"
}

# --- API key storage: macOS keychain, the Secret Service on Linux when
# available, otherwise a file only this user can read.

key_read() {
    if command -v security >/dev/null 2>&1; then
        security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$API_URL" -w 2>/dev/null || true
    elif command -v secret-tool >/dev/null 2>&1; then
        secret-tool lookup service "$KEYCHAIN_SERVICE" account "$API_URL" 2>/dev/null || true
    elif [ -f "$KEY_FILE" ]; then
        cat "$KEY_FILE"
    fi
}

key_write() {
    mkdir -p "$STATE_DIR"
    if command -v security >/dev/null 2>&1; then
        security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$API_URL" -l "Berges CLI" -w "$1" >/dev/null
    elif command -v secret-tool >/dev/null 2>&1; then
        printf '%s' "$1" | secret-tool store --label "Berges CLI" service "$KEYCHAIN_SERVICE" account "$API_URL"
    else
        (umask 077 && printf '%s' "$1" > "$KEY_FILE")
    fi
}

key_delete() {
    if command -v security >/dev/null 2>&1; then
        security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$API_URL" >/dev/null 2>&1 || true
    elif command -v secret-tool >/dev/null 2>&1; then
        secret-tool clear service "$KEYCHAIN_SERVICE" account "$API_URL" 2>/dev/null || true
    fi
    rm -f "$KEY_FILE"
}

# --- HTTP: prints the body, then the status code on its own last line.

http() {
    local method="$1" path="$2"; shift 2
    curl -sS --max-time "${HTTP_TIMEOUT:-15}" -X "$method" "$API_URL$path" \
        -H 'Accept: application/json' -w '\n%{http_code}' "$@" 2>/dev/null || printf '\n000'
}

http_status() { printf '%s' "$1" | tail -n 1; }
http_body() { printf '%s' "$1" | sed '$d'; }

device_name() {
    if command -v scutil >/dev/null 2>&1; then
        scutil --get ComputerName 2>/dev/null && return
    fi
    hostname -s 2>/dev/null || hostname
}

open_browser() {
    if command -v open >/dev/null 2>&1; then
        open "$1" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        xdg-open "$1" >/dev/null 2>&1 || true
    fi
}

# --- Commands

cmd_login() {
    local response status body device_code user_code url interval expires deadline

    response="$(http POST /device/code --data-urlencode "device_name=$(device_name)")"
    status="$(http_status "$response")"
    body="$(http_body "$response")"
    [ "$status" = "200" ] || die "Couldn't reach Berges AI to sign in. Check your connection and try again."

    device_code="$(printf '%s' "$body" | jq -r .device_code)"
    user_code="$(printf '%s' "$body" | jq -r .user_code)"
    url="$(printf '%s' "$body" | jq -r .verification_uri_complete)"
    interval="$(printf '%s' "$body" | jq -r .interval)"
    expires="$(printf '%s' "$body" | jq -r .expires_in)"

    printf '\nTo sign in, open this page and check that it shows the code %s:\n\n  %s\n\n' "$user_code" "$url"
    open_browser "$url"
    printf 'Waiting for you to allow this computer...\n'

    deadline=$(( $(date +%s) + expires ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        sleep "$interval"
        response="$(http POST /device/token --data-urlencode "device_code=$device_code")"
        status="$(http_status "$response")"
        body="$(http_body "$response")"

        if [ "$status" = "200" ]; then
            key_write "$(printf '%s' "$body" | jq -r .api_key)"
            printf 'Signed in.\n\n'
            return 0
        fi

        case "$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)" in
            authorization_pending) ;;
            slow_down) interval=$(( interval + 5 )) ;;
            access_denied) die "Sign-in canceled." ;;
            expired_token) die "The code expired. Run: berges login" ;;
            *) ;;
        esac
    done

    die "The code expired. Run: berges login"
}

cmd_logout() {
    local key
    key="$(key_read)"
    if [ -n "$key" ]; then
        http POST /logout -H "Authorization: Bearer $key" >/dev/null
    fi
    key_delete
    rm -f "$ME_CACHE"
    printf 'Signed out.\n'
}

# Fetches /me into the cache. Returns 0 when fresh data was saved, 1 when signed
# out, 2 when the plan has no CLI, 3 when Berges AI could not be reached.
fetch_me() {
    local response status body
    response="$(HTTP_TIMEOUT=5 http GET /me -H "Authorization: Bearer $1")"
    status="$(http_status "$response")"
    body="$(http_body "$response")"

    case "$status" in
        200) mkdir -p "$STATE_DIR"; printf '%s' "$body" > "$ME_CACHE"; return 0 ;;
        401) return 1 ;;
        403) printf '%s' "$body" | jq -r '.error.message // empty' >&2; return 2 ;;
        *) return 3 ;;
    esac
}

write_goose_config() {
    local providers="$GOOSE_ROOT/config/custom_providers"
    mkdir -p "$providers"

    jq --arg url "$API_URL/chat/completions" '{
        name: "berges",
        engine: "openai",
        display_name: "Berges AI",
        description: "Berges AI models with your pipeline, chatbot and house rules",
        api_key_env: "BERGES_API_KEY",
        base_url: $url,
        models: [.models[] | {name: .id, context_limit: .context_limit, max_tokens: .max_tokens}],
        supports_streaming: true,
        dynamic_models: false,
        skip_canonical_filtering: true
    }' "$ME_CACHE" > "$providers/berges.json"

    # Written once, so changes made later with `goose configure` stick.
    if [ ! -f "$GOOSE_ROOT/config/config.yaml" ]; then
        cat > "$GOOSE_ROOT/config/config.yaml" <<'YAML'
GOOSE_PROVIDER: berges
GOOSE_MODE: smart_approve
GOOSE_TELEMETRY_ENABLED: false
YAML
    fi
}

# --- Banner: the chatbot's sprite, drawn with half blocks (two pixels per
# character cell), next to a few lines of text.

palette_color() {
    local key="$1" line
    while IFS= read -r line; do
        case "$line" in
            "$key "*) printf '%s' "${line#* }"; return ;;
        esac
    done <<EOF
$PALETTE
EOF
}

ansi_color() {
    local layer="$1" hex="$2" r g b
    r=$((16#${hex:0:2})); g=$((16#${hex:2:2})); b=$((16#${hex:4:2}))
    if [ "$TRUECOLOR" = 1 ]; then
        printf '\033[%s;2;%d;%d;%dm' "$layer" "$r" "$g" "$b"
    else
        printf '\033[%s;5;%dm' "$layer" $(( 16 + 36 * ((r * 5 + 127) / 255) + 6 * ((g * 5 + 127) / 255) + (b * 5 + 127) / 255 ))
    fi
}

render_sprite() {
    local file="$1" rows=() line top bottom out i col t b tc bc
    PALETTE=""
    while IFS= read -r line; do
        case "$line" in
            '#'*|'') ;;
            ?' '[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) PALETTE="$PALETTE$line"$'\n' ;;
            *) rows+=("$line") ;;
        esac
    done < "$file"

    SPRITE_LINES=()
    for (( i = 0; i < ${#rows[@]}; i += 2 )); do
        top="${rows[$i]}"; bottom="${rows[$((i + 1))]:-}"; out=""
        for (( col = 0; col < ${#top}; col++ )); do
            t="${top:$col:1}"; b="${bottom:$col:1}"
            [ "$t" = "." ] && tc="" || tc="$(palette_color "$t")"
            [ -z "$b" ] || [ "$b" = "." ] && bc="" || bc="$(palette_color "$b")"
            if [ -z "$tc" ] && [ -z "$bc" ]; then
                out="$out "
            elif [ -z "$bc" ]; then
                out="$out$(ansi_color 38 "$tc")▀"$'\033[0m'
            elif [ -z "$tc" ]; then
                out="$out$(ansi_color 38 "$bc")▄"$'\033[0m'
            else
                out="$out$(ansi_color 38 "$tc")$(ansi_color 48 "$bc")▀"$'\033[0m'
            fi
        done
        SPRITE_LINES+=("$out")
    done
}

print_banner() {
    local chatbot name adjective pipeline plan lines=() sprite cols i
    chatbot="$(jq -r '.chatbot.id // empty' "$ME_CACHE")"
    name="$(jq -r '.chatbot.name // "Berges AI"' "$ME_CACHE")"
    adjective="$(jq -r '.chatbot.adjective // empty' "$ME_CACHE")"
    pipeline="$(jq -r '.pipeline.name // empty' "$ME_CACHE")"
    plan="$(jq -r '.plan // empty' "$ME_CACHE")"

    lines+=("$(printf '\033[1m%s\033[0m%s' "$name" "${adjective:+ · $adjective}")")
    lines+=("Berges AI · powered by goose")
    lines+=("${plan:+$plan plan}${pipeline:+ · $pipeline pipeline}")
    lines+=("/model  /pipeline  /chatbot")

    sprite="$SPRITES_DIR/$chatbot.txt"
    cols="$(tput cols 2>/dev/null || echo 80)"

    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "$cols" -ge 50 ] && [ -n "$chatbot" ] && [ -f "$sprite" ]; then
        case "${COLORTERM:-}" in truecolor|24bit) TRUECOLOR=1 ;; *) TRUECOLOR=0 ;; esac
        render_sprite "$sprite"
        printf '\n'
        for (( i = 0; i < ${#SPRITE_LINES[@]}; i++ )); do
            local text=""
            [ "$i" -ge 2 ] && [ $(( i - 2 )) -lt ${#lines[@]} ] && text="${lines[$((i - 2))]}"
            printf '  %s   %s\n' "${SPRITE_LINES[$i]}" "$text"
        done
        printf '\n'
    else
        printf '\n'
        for text in "${lines[@]}"; do printf '%s\n' "$text"; done
        printf '\n'
    fi
}

cmd_run() {
    local key me_status=0

    require goose
    require jq

    key="$(key_read)"
    if [ -z "$key" ]; then
        printf 'This computer is not signed in to Berges AI yet.\n'
        cmd_login
        key="$(key_read)"
    fi

    fetch_me "$key" || me_status=$?
    if [ "$me_status" = 1 ]; then
        printf 'This computer was signed out of Berges AI.\n'
        key_delete
        cmd_login
        key="$(key_read)"
        fetch_me "$key" || me_status=$?
    fi
    [ "$me_status" = 2 ] && exit 1
    [ -f "$ME_CACHE" ] || die "Couldn't reach Berges AI. Check your connection and try again."

    write_goose_config
    print_banner

    export GOOSE_PATH_ROOT="$GOOSE_ROOT"
    export GOOSE_PROVIDER="berges"
    export GOOSE_MODEL="${GOOSE_MODEL:-$(jq -r '.default_model' "$ME_CACHE")}"
    export GOOSE_TELEMETRY_OFF=1
    export GOOSE_DISABLE_KEYRING=1
    export BERGES_API_KEY="$key"

    if [ "$#" -eq 0 ]; then
        exec goose session
    fi
    exec goose "$@"
}

cmd_help() {
    cat <<EOF
Berges CLI $VERSION: Berges AI as an agent in your terminal, powered by goose.

  berges              Start a session
  berges login        Sign this computer in
  berges logout       Sign this computer out
  berges update       How to update
  berges <command>    Any goose command, e.g. berges run -t "summarize README.md"

In a session: /model, /pipeline and /chatbot switch what answers, /help lists the rest.
More: https://berges.ai/help/use-berges-ai-in-your-terminal
EOF
}

case "${1:-}" in
    login) require jq; cmd_login ;;
    logout) cmd_logout ;;
    update|upgrade) printf 'Update with: brew upgrade berges\n' ;;
    help|-h|--help) cmd_help ;;
    version|-v|--version) printf 'berges %s\n' "$VERSION" ;;
    *) cmd_run "$@" ;;
esac
