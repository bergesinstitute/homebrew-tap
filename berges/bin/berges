#!/usr/bin/env bash
# Berges CLI: Berges AI as an agent in your terminal, built on pi.
#
# Runs pi with its own settings folder (PI_CODING_AGENT_DIR), the Berges AI
# provider and extension, and this computer's key, so it never touches a
# separate pi setup. Written for the bash 3.2 that ships with macOS.

set -euo pipefail

VERSION="0.2.11"
API_URL="${BERGES_API_URL:-https://berges.ai/api/v1}"
STATE_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/berges"
PI_DIR="$STATE_DIR/pi"
ME_CACHE="$STATE_DIR/me.json"
KEY_FILE="$STATE_DIR/credentials"
KEYCHAIN_SERVICE="berges-cli"
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
SHARE_DIR="$(dirname "$SELF")/../share/berges"
[ -d "$SHARE_DIR" ] || SHARE_DIR="$(dirname "$SELF")/.."

die() { printf '%s\n' "$*" >&2; exit 1; }

require() {
    command -v "$1" >/dev/null 2>&1 || die "$1 is missing. Reinstall with: brew reinstall berges"
}

# --- API key storage: macOS keychain, the Secret Service on Linux when
# available, otherwise a file only this user can read.

key_read() {
    if command -v security >/dev/null 2>&1; then
        security find-generic-password -s "$KEYCHAIN_SERVICE" -a "$API_URL" -w 2>/dev/null || true
    elif command -v secret-tool >/dev/null 2>&1; then
        secret-tool lookup service "$KEYCHAIN_SERVICE" account "$API_URL" 2>/dev/null || true
    elif [ -f "$KEY_FILE" ]; then
        cat "$KEY_FILE"
    fi
}

key_write() {
    mkdir -p "$STATE_DIR"
    if command -v security >/dev/null 2>&1; then
        security add-generic-password -U -s "$KEYCHAIN_SERVICE" -a "$API_URL" -l "Berges CLI" -w "$1" >/dev/null
    elif command -v secret-tool >/dev/null 2>&1; then
        printf '%s' "$1" | secret-tool store --label "Berges CLI" service "$KEYCHAIN_SERVICE" account "$API_URL"
    else
        (umask 077 && printf '%s' "$1" > "$KEY_FILE")
    fi
}

key_delete() {
    if command -v security >/dev/null 2>&1; then
        security delete-generic-password -s "$KEYCHAIN_SERVICE" -a "$API_URL" >/dev/null 2>&1 || true
    elif command -v secret-tool >/dev/null 2>&1; then
        secret-tool clear service "$KEYCHAIN_SERVICE" account "$API_URL" 2>/dev/null || true
    fi
    rm -f "$KEY_FILE"
}

# --- HTTP: prints the body, then the status code on its own last line.

http() {
    local method="$1" path="$2"; shift 2
    curl -sS --max-time "${HTTP_TIMEOUT:-15}" -X "$method" "$API_URL$path" \
        -H 'Accept: application/json' -w '\n%{http_code}' "$@" 2>/dev/null || printf '\n000'
}

http_status() { printf '%s' "$1" | tail -n 1; }
http_body() { printf '%s' "$1" | sed '$d'; }

device_name() {
    if command -v scutil >/dev/null 2>&1; then
        scutil --get ComputerName 2>/dev/null && return
    fi
    hostname -s 2>/dev/null || hostname
}

open_browser() {
    if command -v open >/dev/null 2>&1; then
        open "$1" >/dev/null 2>&1 || true
    elif command -v xdg-open >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        xdg-open "$1" >/dev/null 2>&1 || true
    fi
}

# --- Commands

cmd_login() {
    local response status body device_code user_code url interval expires deadline

    response="$(http POST /device/code --data-urlencode "device_name=$(device_name)")"
    status="$(http_status "$response")"
    body="$(http_body "$response")"
    [ "$status" = "200" ] || die "Couldn't reach Berges AI to sign in. Check your connection and try again."

    device_code="$(printf '%s' "$body" | jq -r .device_code)"
    user_code="$(printf '%s' "$body" | jq -r .user_code)"
    url="$(printf '%s' "$body" | jq -r .verification_uri_complete)"
    interval="$(printf '%s' "$body" | jq -r .interval)"
    expires="$(printf '%s' "$body" | jq -r .expires_in)"

    printf '\nTo sign in, open this page and check that it shows the code %s:\n\n  %s\n\n' "$user_code" "$url"
    open_browser "$url"
    printf 'Waiting for you to allow this computer...\n'

    # A little past the code's lifetime, so an approval in its last seconds is
    # still collected.
    deadline=$(( $(date +%s) + expires + 30 ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        sleep "$interval"
        response="$(http POST /device/token --data-urlencode "device_code=$device_code")"
        status="$(http_status "$response")"
        body="$(http_body "$response")"

        if [ "$status" = "200" ]; then
            key_write "$(printf '%s' "$body" | jq -r .api_key)"
            printf 'Signed in.\n\n'
            return 0
        fi

        case "$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)" in
            authorization_pending) ;;
            slow_down) interval=$(( interval + 5 )) ;;
            access_denied) die "Sign-in canceled." ;;
            expired_token) die "The code expired. Run: berges login" ;;
            *) ;;
        esac
    done

    die "The code expired. Run: berges login"
}

cmd_logout() {
    local key
    key="$(key_read)"
    if [ -n "$key" ]; then
        http POST /logout -H "Authorization: Bearer $key" >/dev/null
    fi
    key_delete
    rm -f "$ME_CACHE"
    printf 'Signed out.\n'
}

# Fetches /me into the cache. Returns 0 when fresh data was saved, 1 when signed
# out, 2 when the plan has no CLI, 3 when Berges AI could not be reached.
fetch_me() {
    local response status body
    response="$(HTTP_TIMEOUT=5 http GET /me -H "Authorization: Bearer $1")"
    status="$(http_status "$response")"
    body="$(http_body "$response")"

    case "$status" in
        200) mkdir -p "$STATE_DIR"; printf '%s' "$body" > "$ME_CACHE"; return 0 ;;
        401) return 1 ;;
        403) printf '%s' "$body" | jq -r '.error.message // empty' >&2; return 2 ;;
        *) return 3 ;;
    esac
}

write_pi_config() {
    local settings="$PI_DIR/settings.json" defaults
    mkdir -p "$PI_DIR/extensions" "$PI_DIR/themes"

    # Rewritten on every start, so the models follow the API. Thinking levels
    # are not a Berges AI feature: the server picks the reasoning per model, so
    # `reasoning: false` hides the level from pi instead of offering a control
    # that reaches nothing. Flip this to true once the API honours
    # reasoning_effort; supportsReasoningEffort is kept so that is a one-word
    # change.
    jq --arg url "$API_URL" --arg key "!'$SELF' key" '{
        providers: {
            berges: {
                name: "Berges AI",
                baseUrl: $url,
                api: "openai-completions",
                apiKey: $key,
                compat: {supportsReasoningEffort: true},
                models: [.models[] | {id, name, contextWindow: .context_window, maxTokens: .max_tokens, reasoning: false}]
            }
        }
    }' "$ME_CACHE" > "$PI_DIR/models.json"

    # footer-padding.ts was folded into the footer in berges.ts; remove the
    # stale copy so an upgrade does not leave two extensions setting a footer.
    rm -f "$PI_DIR/extensions/footer-padding.ts"
    cp "$SHARE_DIR/extension/"*.ts "$PI_DIR/extensions/"

    # A theme is cosmetic, so unlike a missing extension it never blocks startup.
    if [ -d "$SHARE_DIR/themes" ]; then
        cp "$SHARE_DIR/themes/"*.json "$PI_DIR/themes/"
    fi

    # Defaults are only added when missing, so changes made in pi stick.
    #
    # `reasoning: false` above only stops pi from asking for a thinking level.
    # The models still stream reasoning_content, and pi turns that into a
    # thinking block whatever the model declares, so hideThinkingBlock is what
    # keeps it out of the transcript. pi would leave a "Thinking..." label in
    # its place; berges.ts blanks it, since the kitchen loader already covers the
    # wait. Ctrl+T still expands the reasoning.
    defaults="$(jq --arg model "$(jq -r '.default_model // empty' "$ME_CACHE")" -n '{
        defaultProvider: "berges",
        defaultModel: $model,
        enableInstallTelemetry: false,
        quietStartup: "header",
        editorPaddingX: 1,
        defaultThinkingLevel: "off",
        hideThinkingBlock: true,
        theme: "berges-light/berges-dark"
    }')"
    if [ -f "$settings" ]; then
        jq --argjson defaults "$defaults" '$defaults + .' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
    else
        printf '%s\n' "$defaults" > "$settings"
    fi

    # Always set: /share goes to the user's own GitHub, never pi's service.
    jq '.sessionShareDestination = "gist"' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"

    # The default model follows the chat's model until one is saved in pi
    # (Ctrl+S in /model): it is updated only while it still equals the chat
    # model written last time.
    local web_model last_web="$STATE_DIR/web-model" current
    web_model="$(jq -r '.default_model // empty' "$ME_CACHE")"
    current="$(jq -r '.defaultModel // empty' "$settings")"
    if [ -n "$web_model" ] && { [ ! -f "$last_web" ] || [ "$current" = "$(cat "$last_web")" ]; }; then
        jq --arg model "$web_model" '.defaultProvider = "berges" | .defaultModel = $model' "$settings" > "$settings.tmp" && mv "$settings.tmp" "$settings"
    fi
    [ -z "$web_model" ] || printf '%s' "$web_model" > "$last_web"
}

cmd_run() {
    local key me_status=0

    require pi
    require jq

    key="$(key_read)"
    if [ -z "$key" ]; then
        printf 'This computer is not signed in to Berges AI yet.\n'
        cmd_login
        key="$(key_read)"
    fi

    fetch_me "$key" || me_status=$?
    if [ "$me_status" = 1 ]; then
        printf 'This computer was signed out of Berges AI.\n'
        key_delete
        cmd_login
        key="$(key_read)"
        fetch_me "$key" || me_status=$?
    fi
    [ "$me_status" = 2 ] && exit 1
    [ -f "$ME_CACHE" ] || die "Couldn't reach Berges AI. Check your connection and try again."

    write_pi_config

    export PI_CODING_AGENT_DIR="$PI_DIR"
    export PI_OFFLINE=1
    export PI_TELEMETRY=0
    export PI_SKIP_VERSION_CHECK=1
    export BERGES_API_URL="$API_URL"
    export BERGES_BIN="$SELF"

    exec pi "$@"
}

cmd_key() {
    local key
    key="$(key_read)"
    [ -n "$key" ] || die "This computer is not signed in. Run: berges login"
    printf '%s\n' "$key"
}

cmd_help() {
    cat <<EOF
Berges CLI $VERSION: Berges AI as an agent in your terminal, built on pi.

  berges              Start a session
  berges login        Sign this computer in
  berges logout       Sign this computer out
  berges update       How to update
  berges [pi options] Any pi option, e.g. berges -p "summarize README.md"

In a session: /model, /pipeline and /chatbot switch what answers.
More: https://berges.ai/help/use-berges-ai-in-your-terminal
EOF
}

case "${1:-}" in
    login) require jq; cmd_login ;;
    key) cmd_key ;;
    logout) cmd_logout ;;
    update|upgrade) printf 'Update with: brew upgrade berges\n' ;;
    help|-h|--help) cmd_help ;;
    version|-v|--version) printf 'berges %s\n' "$VERSION" ;;
    *) cmd_run "$@" ;;
esac
